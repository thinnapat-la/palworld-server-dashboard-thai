# Palworld 1.1.0 - Windows Host-native mode
# steamcmd.exe และ PalServer.exe รันบน Windows โดยตรง; Docker ใช้เฉพาะ Dashboard

# ตำแหน่งติดตั้ง Windows Dedicated Server ต้องใช้ path สั้น
# ตอนสร้าง .env.host สคริปต์จะเปลี่ยน Drive ให้ตรงกับตำแหน่งโปรเจกต์อัตโนมัติ
PALWORLD_HOST_DIR=C:/PalServer

# Gameplay / REST / RCON
PALWORLD_SERVER_NAME=Mien Palworld Windows
PALWORLD_SERVER_PASSWORD=
PALWORLD_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
PALWORLD_HOST_PORT=8211
PALWORLD_HOST_QUERY_PORT=27015
PALWORLD_HOST_REST_PORT=8212
PALWORLD_HOST_RCON_PORT=25575
PALWORLD_HOST_PUBLIC_LOBBY=true

# Native Windows SteamCMD
# Setup จะดาวน์โหลด steamcmd.exe ทางการไว้ใน runtime/steamcmd-windows
PALWORLD_STEAMCMD_DOWNLOAD_URL=https://client-update.steamstatic.com/installer/steamcmd.zip
PALWORLD_STEAMCMD_VALIDATE=true
PALWORLD_STEAMCMD_RETRIES=2

# Native startup arguments
PALWORLD_HOST_PERF_ARGS=false
PALWORLD_HOST_WORKER_THREADS=
PALWORLD_HOST_EXTRA_ARGS=
PALWORLD_HOST_STOP_TIMEOUT_SECONDS=60
PALWORLD_HOST_START_TIMEOUT_SECONDS=900
PALWORLD_EXTERNAL_CONTROL_TIMEOUT=90
PALWORLD_HOST_AUTO_OPEN_DASHBOARD=true

# ใช้เฉพาะคำสั่ง 09-Move-Server-To-Short-Path.bat; เว้นว่างเพื่อใช้ <ProjectDrive>:/PalServer
PALWORLD_HOST_SHORT_DIR=

# Host address ที่ Dashboard container ใช้เรียก REST API บน Windows
PALWORLD_HOST_API_HOST=host.docker.internal

# Dashboard
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD
DASHBOARD_REFRESH_SECONDS=30
DASHBOARD_ACTIONS_ENABLED=true
DASHBOARD_CPU_LIMIT=0.25
DASHBOARD_MEMORY_LIMIT=256m
DASHBOARD_MEMORY_RESERVATION=128m
DASHBOARD_PIDS_LIMIT=128

# Discord dashboard workflow notifications
DASHBOARD_DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_INFORMATION_WEBHOOK_URL=

# Docker logging
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=3

# Import / Export
DASHBOARD_MAX_UPLOAD_MB=4096
DASHBOARD_MAX_EXPANDED_MB=8192
DASHBOARD_MAX_CONFIG_KB=1024
DASHBOARD_MAX_CONFIG_BACKUPS=100
PALWORLD_START_TIMEOUT_SECONDS=900
PALWORLD_STOP_TIMEOUT_SECONDS=60
