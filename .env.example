# Palworld credentials
PALWORLD_SERVER_PASSWORD=CHANGE_ME_PLAYER_PASSWORD
PALWORLD_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# World Actor Snapshot / GameData API
# Requires thijsvanloef/palworld-server-docker 2.6.0 or newer.
# "true" for open
ENABLE_GAMEDATA_API=false

# Discord
# Create separate webhooks per channel if desired. Never commit real webhook URLs.
DISCORD_INFORMATION_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME
DISCORD_WELCOME_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME
DISCORD_SESSION_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME
DISCORD_INVITE_URL=https://discord.gg/CHANGE_ME

# Dashboard login
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD
DASHBOARD_REFRESH_SECONDS=15
DASHBOARD_ACTIONS_ENABLED=true

# Dashboard Import / Export
DASHBOARD_MAX_UPLOAD_MB=4096
DASHBOARD_MAX_EXPANDED_MB=8192
PALWORLD_START_TIMEOUT_SECONDS=900
PALWORLD_STOP_TIMEOUT_SECONDS=60
