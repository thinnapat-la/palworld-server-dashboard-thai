# Palworld credentials
# Linux Docker server lifecycle
# First init/update only: true. Normal start: false.
PALWORLD_UPDATE_ON_BOOT=false
PALWORLD_ENABLE_PERF_THREADING_ARGS=true
# Leave empty to let Palworld choose worker count.
PALWORLD_WORKER_THREADS_SERVER=
ENABLE_PLAYER_LOGGING=false
LOG_FILTER_ENABLED=false
BACKUP_ENABLED=true
AUTO_REBOOT_ENABLED=false

PALWORLD_SERVER_PASSWORD=CHANGE_ME_PLAYER_PASSWORD
PALWORLD_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# World Actor Snapshot / GameData API
# Requires thijsvanloef/palworld-server-docker 2.6.0 or newer.
# "true" for open
ENABLE_GAMEDATA_API=false

# Discord
# Master switches: false disables requests even when a webhook URL is still configured.
DISCORD_SERVER_NOTIFICATIONS_ENABLED=false
DISCORD_PLAYER_NOTIFICATIONS_ENABLED=false
DASHBOARD_DISCORD_NOTIFICATIONS_ENABLED=false
# Create separate webhooks per channel if desired. Never commit real webhook URLs.
DISCORD_INFORMATION_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME
DISCORD_WELCOME_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME
DISCORD_SESSION_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME
DISCORD_INVITE_URL=https://discord.gg/CHANGE_ME

# Dashboard login
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD
DASHBOARD_REFRESH_SECONDS=30
DASHBOARD_ACTIONS_ENABLED=true
PLAYER_LOGGING_POLL_PERIOD=60

# Manual PalWorldSettings.ini
# Fresh install: keep false for first successful boot, then change to true and recreate palworld.
PALWORLD_DISABLE_GENERATE_SETTINGS=false

# Compose resource tuning
PALWORLD_VOLUME_NAME=palworld-data
PALWORLD_MEMORY_RESERVATION=8g
DASHBOARD_CPU_LIMIT=0.25
DASHBOARD_MEMORY_LIMIT=256m
DASHBOARD_MEMORY_RESERVATION=128m
DASHBOARD_PIDS_LIMIT=128
DOCKER_PROXY_CPU_LIMIT=0.10
DOCKER_PROXY_MEMORY_LIMIT=64m
DOCKER_PROXY_MEMORY_RESERVATION=32m
DOCKER_PROXY_PIDS_LIMIT=64

# Docker local logging driver rotation
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=3

# Dashboard Import / Export
DASHBOARD_MAX_UPLOAD_MB=4096
DASHBOARD_MAX_EXPANDED_MB=8192
DASHBOARD_MAX_CONFIG_KB=1024
DASHBOARD_MAX_CONFIG_BACKUPS=100
PALWORLD_START_TIMEOUT_SECONDS=900
PALWORLD_STOP_TIMEOUT_SECONDS=60
